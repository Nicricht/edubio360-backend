# syntax=docker/dockerfile:1
FROM maven:3.9-eclipse-temurin-26 AS build
ARG MODULE
WORKDIR /workspace
COPY pom.xml .
COPY discovery-server discovery-server
COPY api-gateway api-gateway
COPY auth-service auth-service
COPY academic-service academic-service
COPY guidance-service guidance-service
COPY notification-service notification-service
COPY analytics-service analytics-service
COPY import-service import-service

RUN --mount=type=cache,id=edubio360-maven-repository,target=/root/.m2/repository,sharing=locked \
    mvn -B -ntp -U -pl "${MODULE}" -am clean package -DskipTests \
    -Daether.transport.http.retryHandler.count=6

FROM eclipse-temurin:21-jre
ARG MODULE
ARG HEALTH_PORT=8080
ENV HEALTH_PORT=${HEALTH_PORT}
ENV JAVA_TOOL_OPTIONS="-Djavax.xml.accessExternalDTD= -Djavax.xml.accessExternalSchema= -Djavax.xml.accessExternalStylesheet="
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=10001:10001 /workspace/${MODULE}/target/*.jar app.jar
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
    CMD curl -fsS "http://127.0.0.1:${HEALTH_PORT}/actuator/health" >/dev/null || exit 1
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
