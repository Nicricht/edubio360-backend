  "item": [
    {
      "name": "00 Autenticación · Gateway",
      "item": [
        {
          "name": "1 Ruta protegida sin JWT → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/ofertas",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2 Registrar estudiante → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{gatewayEmail}}\",\"password\":\"{{gatewayPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('gatewayEmail', 'ep02-gw-' + Date.now() + '-' + Math.floor(Math.random() * 1000000) + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test('Registro devuelve id', function () { pm.expect(data.id).to.be.a('number'); });",
                  "pm.collectionVariables.set('bootstrapUserId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3 Login → 200 + JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{gatewayEmail}}\",\"password\":\"{{gatewayPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('JWT recibido', function () { pm.expect(data.token).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('accessToken', data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "4 Consulta académica vía Gateway con JWT → 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/ofertas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test('Ofertas en JSON', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    },
