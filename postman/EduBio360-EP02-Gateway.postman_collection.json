{
  "info": {
    "name": "EduBio360-EP02-Gateway",
    "description": "Colección independiente para validación EP02 a través del API Gateway :8080. Cubre los 42 CRUD originales, el rechazo sin JWT, registro, login, acceso protegido y limpieza. No reemplaza la colección original.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "gatewayPassword",
      "value": "example-pass-123"
    },
    {
      "key": "gatewayEmail",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "bootstrapUserId",
      "value": ""
    },
    {
      "key": "crudEmail",
      "value": ""
    },
    {
      "key": "crudUpdatedEmail",
      "value": ""
    },
    {
      "key": "authId",
