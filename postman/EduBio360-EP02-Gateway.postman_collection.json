      "value": ""
    },
    {
      "key": "autoAuthUserId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Autenticación · Gateway",
      "item": [
        {
          "name": "1 Ruta protegida sin JWT → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/ofertas",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2 Registrar estudiante → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{gatewayEmail}}\",\"password\":\"{{gatewayPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('gatewayEmail', 'ep02-gw-' + Date.now() + '-' + Math.floor(Math.random() * 1000000) + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Registro devuelve identificador', function () {",
                  "    const user = pm.response.json();",
                  "    pm.expect(user.id).to.be.a('number');",
                  "    pm.collectionVariables.set('bootstrapUserId', user.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3 Login → 200 + JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{gatewayEmail}}\",\"password\":\"{{gatewayPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Inicio de sesión entrega JWT', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('accessToken', response.token);",
                  "    pm.collectionVariables.set('accessTokenIssuedAt', Date.now());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4 Consulta académica vía Gateway con JWT → 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/ofertas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test('Ofertas en JSON', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    },
