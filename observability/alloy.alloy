local.file_match "docker" {
  path_targets = [{__path__ = "/var/lib/docker/containers/*/*-json.log", job = "edubio-docker"}]
}
loki.source.file "docker" {
  targets = local.file_match.docker.targets
  forward_to = [loki.process.docker.receiver]
}
loki.process "docker" {
  stage.json {
    expressions = { attrs = "" }
  }
  stage.docker {}
  stage.json {
    source = "attrs"
    expressions = { tag = "" }
  }
  stage.regex {
    source = "tag"
    expression = "^edubio_(?P<service>[^.]+)[.]"
  }
  stage.labels {
    values = { service = "" }
  }
  stage.match {
    selector = "{job=\"edubio-docker\",service!~\".+\"}"
    action = "drop"
  }
  stage.label_drop {
    values = ["filename"]
  }
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
