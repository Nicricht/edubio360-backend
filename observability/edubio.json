{
  "uid": "edubio-ep3",
  "title": "EduBío 360 - métricas de microservicios",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad por servicio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "edubio-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Peticiones HTTP por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "edubio-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errores HTTP 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "edubio-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latencia promedio HTTP",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "edubio-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_sum[5m])) / sum by (job) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "CPU del proceso JVM",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "edubio-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Memoria JVM usada",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "edubio-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, instance) (jvm_memory_used_bytes)",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    }
  ]
}
